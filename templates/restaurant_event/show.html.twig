{% extends 'base.html.twig' %}

{% block title %}RestaurantEvent{% endblock %}

{% block body %}
    <h1>RestaurantEvent</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ restaurant_event.id }}</td>
            </tr>
            <tr>
                <th>Title</th>
                <td>{{ restaurant_event.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ restaurant_event.description }}</td>
            </tr>
            <tr>
                <th>StartDatetime</th>
                <td>{{ restaurant_event.startDatetime ? restaurant_event.startDatetime|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>EndDatetime</th>
                <td>{{ restaurant_event.endDatetime ? restaurant_event.endDatetime|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>ImagePath</th>
                <td>{{ restaurant_event.imagePath }}</td>
            </tr>
            <tr>
                <th>IsPublished</th>
                <td>{{ restaurant_event.isPublished ? 'Yes' : 'No' }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ restaurant_event.createdAt ? restaurant_event.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ restaurant_event.updatedAt ? restaurant_event.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_restaurant_event_index') }}">back to list</a>

    <a href="{{ path('app_restaurant_event_edit', {'id': restaurant_event.id}) }}">edit</a>

    {{ include('restaurant_event/_delete_form.html.twig') }}
{% endblock %}
