
{% extends 'base.html.twig' %}

{% block title %}Connexion | Chez Aka{% endblock %}

{% block meta_description %}
    Connectez-vous à votre compte Chez Aka.
{% endblock %}

{% block body %}
<main class="auth-page">
    <section class="auth-card" aria-labelledby="login-title">

        <h1 id="login-title" class="auth-title">
            Connexion
        </h1>

        {% if error %}
            <div class="alert alert-danger" role="alert">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        {% if app.user %}
            <div class="auth-connected">
                <p>
                    Connecté en tant que
                    {{ app.user.userIdentifier }}
                </p>

                <a href="{{ logout_path() }}">
                    Se déconnecter
                </a>
            </div>
        {% endif %}

        <form
            action="{{ path('app_login') }}"
            method="post"
            class="auth-form"
        >
            <div class="auth-field">
                <label for="username">
                    Adresse e-mail
                </label>

                <input
                    type="email"
                    id="username"
                    name="_username"
                    value="{{ last_username }}"
                    autocomplete="email"
                    placeholder="exemple@email.fr"
                    required
                    autofocus
                >
            </div>

            <div class="auth-field">
                <label for="password">
                    Mot de passe
                </label>

                <input
                    type="password"
                    id="password"
                    name="_password"
                    autocomplete="current-password"
                    required
                >
            </div>

            <input
                type="hidden"
                name="_csrf_token"
                data-controller="csrf-protection"
                value="{{ csrf_token('authenticate') }}"
            >

            <button type="submit" class="auth-submit">
                Se connecter
            </button>
        </form>

        <div class="auth-footer">
            <span>Pas encore de compte ?</span>

            <a href="{{ path('app_register') }}">
                Créer un compte
            </a>
        </div>

    </section>
</main>
{% endblock %}
