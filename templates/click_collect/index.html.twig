{% extends 'base.html.twig' %}

{% block title %}Click & Collect - Chez Aka{% endblock %}

{% block body %}
    <main>
        <h1>Click & Collect</h1>
        <p>
            <a href="{{ path('app_cart_index') }}">
                Voir mon panier
            </a>
        </p>
        <p>
            Commandez vos plats en ligne et récupérez votre commande
            directement chez Chez Aka.
        </p>

        <p>
            Retrait disponible les jours d'ouverture,
            entre 20h00 et 22h30.
        </p>

        <p>
            Un compte client sera nécessaire pour passer commande.
        </p>

        {% if products_by_category is empty %}
            <p>
                Aucun produit n'est actuellement disponible
                en Click & Collect.
            </p>
        {% else %}

            {% for section in products_by_category %}
                <section>
                    <h2>
                        {{ section.category.name }}
                    </h2>

                    {% for product in section.products %}
                        <article>
                            <h3>
                                {{ product.name }}
                            </h3>

                            {% if product.description %}
                                <p>
                                    {{ product.description }}
                                </p>
                            {% endif %}

                            <p>
                                <strong>
                                    {{ product.price|number_format(2, ',', ' ') }} €
                                </strong>
                            </p>

                            <form
                                method="post"
                                action="{{ path('app_cart_add', { id: product.id }) }}"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('cart_add_' ~ product.id) }}"
                                >

                                <button type="submit">
                                    Ajouter au panier
                                </button>
                            </form>
                        </article>
                    {% endfor %}
                </section>
            {% endfor %}

        {% endif %}
    </main>
{% endblock %}
