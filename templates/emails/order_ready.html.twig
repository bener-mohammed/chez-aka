<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Commande prête</title>
</head>

<body>
    <h1>Votre commande est prête !</h1>

    <p>
        Bonjour {{ order.user.firstName }},
    </p>

    <p>
        Bonne nouvelle : votre commande Click & Collect
        est prête à être récupérée chez Chez Aka.
    </p>

    <p>
        <strong>Commande :</strong>
        {{ order.orderNumber }}
    </p>

    <p>
        <strong>Date :</strong>
        {{ order.serviceDay.serviceDate|date('d/m/Y') }}
    </p>

    <p>
        <strong>Heure de retrait prévue :</strong>
        {{ order.pickupTime|date('H:i') }}
    </p>

    <p>
        <strong>Total payé :</strong>
        {{ order.totalAmount|number_format(2, ',', ' ') }} €
    </p>

    <p>
        À tout de suite chez Chez Aka !
    </p>
</body>
</html>