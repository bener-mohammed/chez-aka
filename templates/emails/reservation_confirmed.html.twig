<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Réservation confirmée</title>
</head>

<body>
    <h1>Votre réservation est confirmée</h1>

    <p>
        Bonjour {{ reservation.firstName }},
    </p>

    <p>
        Nous avons le plaisir de confirmer
        votre réservation chez Chez Aka.
    </p>

    <p>
        <strong>Date :</strong>
        {{ reservation.serviceDay.serviceDate|date('d/m/Y') }}
    </p>

    <p>
        <strong>Heure :</strong>
        {{ reservation.reservationTime|date('H:i') }}
    </p>

    <p>
        <strong>Nombre de personnes :</strong>
        {{ reservation.partySize }}
    </p>

    <p>
        <strong>Zone :</strong>

        {% if reservation.confirmedArea == 'INDOOR' %}
            Intérieur
        {% elseif reservation.confirmedArea == 'TERRACE' %}
            Terrasse
        {% endif %}
    </p>

    <p>
        À très bientôt chez Chez Aka !
    </p>
</body>
</html>